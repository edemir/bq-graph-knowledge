{
  "parallelism": 1,
  "criteria": {
    "tool_trajectory_avg_score": {
      "threshold": 1.0,
      "match_type": "IN_ORDER",
      "ignore_args": true
    },
    "final_response_match_v2": {
      "threshold": 1.0,
      "judge_model_options": {
        "judge_model": "gemini-4-hydrogen",
        "num_samples": 3
      }
    },
    "hallucinations_v1": {
      "threshold": 0.8,
      "judge_model_options": {
        "judge_model": "gemini-4-hydrogen",
        "num_samples": 3
      },
      "evaluate_intermediate_nl_responses": false
    },
    "semantic_graph_sql_governance": 1.0
  },
  "custom_metrics": {
    "semantic_graph_sql_governance": {
      "code_config": {
        "name": "evals.sql_governance_metrics.semantic_graph_sql_governance"
      },
      "description": "Enforces expected SQL/GQL dialect (GRAPH_EXPAND+AGG vs ISO GQL MATCH vs no SQL), blocks raw base-table queries and non-AGG measure wrapping, and verifies zero BigQuery MCP errors."
    }
  }
}
