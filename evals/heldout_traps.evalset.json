          "final_response": {
            "parts": [{"text": "Acme (Cust-001) needed the most support time per dollar spent at 0.012 support hours per dollar (12 hours / $1,000.00). Cozy (Cust-003) is 0.0 hours per dollar (0 hours / $200.00). Beta (Cust-002) has 2 support hours and $0.00 spent, so their ratio is undefined (NULL)."}],
            "role": "model"
          }
        }
      ],
      "session_input": {"app_name": "agent", "user_id": "evaluator"}
    },
